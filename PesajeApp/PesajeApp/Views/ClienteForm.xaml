<Window x:Class="PesajeApp.Views.ClienteForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Cliente"
        Height="350"
        Width="450"
        WindowStartupLocation="CenterOwner"
        Icon="../Assets/logo.ico"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Código -->
        <TextBlock Grid.Row="0"
                   Text="Código"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="1"
                 x:Name="CodigoTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <!-- Nombres -->
        <TextBlock Grid.Row="2"
                   Text="Nombres"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="3"
                 x:Name="NombresTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <!-- Sede -->
        <TextBlock Grid.Row="4"
                   Text="Sede"
                   Margin="0,0,0,5"/>

        <ComboBox Grid.Row="5"
                  x:Name="SedeComboBox"
                  Height="30"
                  DisplayMemberPath="Nombre"
                  SelectedValuePath="Id"/>

        <!-- Botones -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Guardar"
                    Width="100"
                    Height="35"
                    Margin="5,0,0,0"
                    Click="Guardar_Click"/>

            <Button Content="Cancelar"
                    Width="100"
                    Height="35"
                    Margin="5,0,0,0"
                    Click="Cancelar_Click"/>

        </StackPanel>

    </Grid>

</Window>
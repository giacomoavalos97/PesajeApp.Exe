<Window x:Class="PesajeApp.Views.BalanzaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de balanza"
        Height="650"
        Width="750"
        Icon="../Assets/logo.ico"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configuración de balanza"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Modelo -->

        <TextBlock Grid.Row="1"
                   Text="Modelo"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="2"
                 x:Name="ModeloTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <!-- Modo -->

        <TextBlock Grid.Row="3"
                   Text="Modo"
                   Margin="0,0,0,5"/>

        <ComboBox Grid.Row="4"
                  x:Name="ModoComboBox"
                  Height="30"
                  Margin="0,0,0,15">

            <ComboBoxItem Content="Continuo"/>

        </ComboBox>

        <!-- Parámetros -->

        <Grid Grid.Row="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Puerto"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="PortNameTextBox"
                         Height="30"/>

            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="BaudRate"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="BaudRateTextBox"
                         Height="30"/>

            </StackPanel>

            <StackPanel Grid.Column="4">

                <TextBlock Text="DataBits"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="DataBitsTextBox"
                         Height="30"/>

            </StackPanel>

        </Grid>

        <!-- Parity -->

        <StackPanel Grid.Row="6"
                    Margin="0,15,0,15">

            <TextBlock Text="Parity"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="ParityComboBox"
                      Height="30">

                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Odd"/>
                <ComboBoxItem Content="Even"/>

            </ComboBox>

        </StackPanel>

        <!-- Terminal -->

        <GroupBox Grid.Row="7"
                  Header="Datos recibidos de la balanza"
                  Margin="0,0,0,15">

            <TextBox x:Name="TerminalTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"/>

        </GroupBox>

        <!-- Botones -->

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Probar conexión"
                    Width="130"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="ProbarConexion_Click"/>

            <Button Content="Guardar"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Guardar_Click"/>

            <Button Content="Cerrar"
                    Width="100"
                    Height="35"
                    Click="Cerrar_Click"/>

        </StackPanel>

    </Grid>

</Window>
<Window x:Class="PesajeApp.Views.ClientesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes"
        Height="500"
        Width="800"
        Icon="../Assets/logo.ico"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Clientes"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="ClientesDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Código"
                                    Binding="{Binding Cod}"
                                    Width="100"/>

                <DataGridTextColumn Header="Nombres"
                                    Binding="{Binding Nombres}"
                                    Width="*"/>

                <DataGridTextColumn Header="Sede"
                                    Binding="{Binding SedeNombre}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Estado"
                                        Binding="{Binding Estado}"
                                        Width="80"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">

            <Button Content="Nuevo"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="Nuevo_Click"/>

            <Button Content="Editar"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="Editar_Click"/>

            <Button Content="Desactivar"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="Desactivar_Click"/>

        </StackPanel>

    </Grid>

</Window>
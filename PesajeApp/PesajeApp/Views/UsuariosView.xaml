<Window x:Class="PesajeApp.Views.UsuariosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuarios"
        Height="450"
        Width="800"
        Icon="../Assets/logo.ico"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Usuarios"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1"
                  x:Name="UsuariosDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Usuario"
                                    Binding="{Binding Nombre}"
                                    Width="150"/>

                <DataGridTextColumn Header="Sede"
                                    Binding="{Binding SedeNombre}"
                                    Width="180"/>

                <DataGridTextColumn Header="Rol"
                                    Binding="{Binding Rol}"
                                    Width="150"/>

                <DataGridTextColumn Header="Turno"
                                    Binding="{Binding Turno}"
                                    Width="120"/>

                <DataGridTemplateColumn Header="Acciones" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">

                                <Button Content="Editar"
                                        Width="70"
                                        Height="25"
                                        Margin="0,0,5,0"
                                        Click="EditarUsuario_Click"/>

                                <Button Content="Desactivar"
                                        Width="85"
                                        Height="25"
                                        Click="DesactivarUsuario_Click"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Nuevo usuario"
                    Width="130"
                    Height="35"
                    Click="NuevoUsuario_Click"/>

        </StackPanel>

    </Grid>

</Window>
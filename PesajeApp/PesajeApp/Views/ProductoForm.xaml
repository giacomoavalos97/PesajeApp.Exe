<Window x:Class="PesajeApp.Views.ProductoForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Producto"
        Height="536"
        Width="500"
        Icon="../Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Código"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="1"
                 x:Name="CodigoTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2"
                   Text="Descripción"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="3"
                 x:Name="DescripcionTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="4"
                   Text="Precio"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="5"
                 x:Name="PrecioTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="6"
                   Text="Caducidad"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="7"
                 x:Name="CaducidadTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="8"
                   Text="Cantidad"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="9"
                 x:Name="CantidadTextBox"
                 Height="30"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="10"
                   Text="Sede"
                   Margin="0,0,0,5"/>

        <ComboBox Grid.Row="11"
                  x:Name="SedeComboBox"
                  Height="30"
                  DisplayMemberPath="Nombre"
                  SelectedValuePath="Id"
                  Margin="0,0,0,15"/>

        <StackPanel Grid.Row="13"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Guardar"
                    Width="100"
                    Height="35"
                    Margin="5,0,0,0"
                    Click="Guardar_Click"/>

            <Button Content="Cancelar"
                    Width="100"
                    Height="35"
                    Margin="5,0,0,0"
                    Click="Cancelar_Click"/>

        </StackPanel>

    </Grid>

</Window>
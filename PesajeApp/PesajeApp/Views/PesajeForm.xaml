<Window x:Class="PesajeApp.Views.PesajeForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Pesaje"
        Height="698"
        Width="1000"
        Icon="../Assets/logo.ico"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- PRODUCTOS                  -->
        <!-- ========================= -->

        <GroupBox Grid.Row="0"
                  Header="Productos"
                  Padding="10">

            <DataGrid x:Name="ProductosDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="ProductosDataGrid_SelectionChanged"
                      Height="180">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Código"
                                        Binding="{Binding Cod}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Descripcion}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Cantidad"
                                        Binding="{Binding Cantidad}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Precio"
                                        Binding="{Binding Precio, StringFormat=N3}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Sede"
                                        Binding="{Binding SedeNombre}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>


        <!-- ========================= -->
        <!-- PESO                       -->
        <!-- ========================= -->

        <GroupBox Grid.Row="2"
                  Header="Peso" Margin="45,8,665,12" Grid.RowSpan="2">

            <TextBlock x:Name="PesoTextBlock"
                       Text="0.000"
                       FontSize="42"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="10"/>

        </GroupBox>

        <!-- ========================= -->
        <!-- PRECIO CON TARA           -->
        <!-- ========================= -->

        <GroupBox Grid.Row="3"
          Header="Importe con tara" Margin="351,10,359,10">

            <TextBlock x:Name="ImporteConTaraTextBlock"
               Text="S/ 0.000"
               FontSize="36"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="10"/>

        </GroupBox>

        <!-- ========================= -->
        <!-- IMPORTE                    -->
        <!-- ========================= -->

        <GroupBox Grid.Row="3"
                  Header="Importe" Margin="637,10,73,10">

            <TextBlock x:Name="ImporteTextBlock"
                       Text="S/ 0.000"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="10"/>

        </GroupBox>


        <!-- ========================= -->
        <!-- DATOS DEL PESaje            -->
        <!-- ========================= -->

        <GroupBox Grid.Row="8"
                  Header="Datos del pesaje"
                  Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Tara -->

                <TextBlock
                           Grid.Column="0"
                           Text="Tara:"
                           VerticalAlignment="Center" Margin="0,0,54,0"/>

                <TextBox x:Name="PesoTaraTextBox"
                         Grid.Row="0"
                         Height="30"
                         TextChanged="PesoTaraTextBox_TextChanged" Margin="101,0,156,0" Grid.ColumnSpan="2"/>


                <!-- Peso Neto -->

                <TextBlock
                           Text="Peso neto:"
                           VerticalAlignment="Center" Margin="144,0,10,0" Grid.Column="1"/>

                <TextBox x:Name="PesoNetoTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="30"
                         IsReadOnly="True"
                         Grid.ColumnSpan="3" Margin="243,0,227,0"/>


                <!-- Lote -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Lote:"
                           VerticalAlignment="Center" Margin="0,0,54,0"/>

                <TextBox x:Name="LoteTextBox"
                         Grid.Row="2"
                         Height="30"
                         MaxLength="20" Grid.ColumnSpan="2" Margin="101,0,156,0"/>
                <TextBlock
                    Text="OP:"
                    VerticalAlignment="Center" Margin="144,0,10,0" Grid.Column="1" Grid.Row="2"/>
                <TextBox x:Name="OperacionTextBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="30"
                    Grid.ColumnSpan="3" Margin="243,0,227,0"/>
                <TextBlock
                    Text="Kanban:"
                    VerticalAlignment="Center" Margin="64,0,90,0" Grid.Column="3"/>
                <TextBox x:Name="KanbanTextBox"
                    Grid.Column="3"
                    Height="30"
                    Margin="163,0,-93,0"/>
                <TextBlock
                    Text="Cod Alt:"
                    VerticalAlignment="Top" Margin="64,0,90,0" Grid.Column="3" Grid.Row="2"/>
                <TextBox x:Name="CodAltTextBox"
                    Grid.Column="3"
                    Height="30"
                    Margin="163,8,-93,7" Grid.RowSpan="2" Grid.Row="1"/>

            </Grid>

        </GroupBox>

        <!-- ========================= -->
        <!-- BOTONES                    -->
        <!-- ========================= -->

        <StackPanel Grid.Row="12"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Guardar"
                    Width="130"
                    Height="40"
                    Margin="5"
                    Click="Guardar_Click"/>

            <Button Content="Guardar e imprimir"
                    Width="160"
                    Height="40"
                    Margin="5"
                    Click="GuardarEImprimir_Click"/>

        </StackPanel>

    </Grid>

</Window>
<Window x:Class="PesajeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PesajeApp"
        Height="600"
        Width="900"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        Icon="./Assets/logo.ico">

    <Window.Resources>
        <!-- Estilo base para los botones principales -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  Opacity="0.15"
                                                  BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000"
                                                          Opacity="0.3"
                                                          BlurRadius="18"
                                                          ShadowDepth="5"
                                                          Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo elegante para el botón secundario "Ver pesajes" -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#FFFFFF"
                                CornerRadius="12"
                                BorderBrush="#D5DBDB"
                                BorderThickness="1.5"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  Opacity="0.08"
                                                  BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6"
                                                          Opacity="0.25"
                                                          BlurRadius="16"
                                                          ShadowDepth="3"
                                                          Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EAF2FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="#1F2A38"
                Padding="20,18">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  Opacity="0.25"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="UsuarioTextBlock"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Text="Nombre de Usuario"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock x:Name="SedeTextBlock"
                               FontSize="14"
                               Foreground="#AAB7B8"
                               Margin="10,0"/>
                    <TextBlock Text="•"
                               FontSize="14"
                               Foreground="#AAB7B8"/>
                    <TextBlock x:Name="TurnoTextBlock"
                               FontSize="14"
                               Foreground="#AAB7B8"
                               Margin="10,0"/>
                    <TextBlock Text="•"
                               FontSize="14"
                               Foreground="#AAB7B8"/>
                    <TextBlock x:Name="RolTextBlock"
                               FontSize="14"
                               Foreground="#AAB7B8"
                               Margin="10,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Botones principales -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Rows="3"
                         Columns="3"
                         Margin="40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">

                <Button Content="Usuarios"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#3B82F6"
                        Click="AbrirUsuarios_Click"/>

                <Button Content="Balanza"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#10B981"
                        Click="Balanza_Click"/>

                <Button Content="Producto"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#8B5CF6"
                        Click="AbrirProductos_Click"/>

                <Button Content="Nuevo Pesaje"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#F59E0B"
                        Click="Pesaje_Click"/>

                <Button Content="Impresora"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#EF4444"
                        Click="AbrirImpresora_Click"/>

                <Button Content="Clientes"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#22C55E"
                        Click="AbrirClientes_Click"/>

                <Button Content="Sede"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#F97316"
                        Click="AbrirClientes_Click"/>

                <Button Content="Empresa"
                        Style="{StaticResource MenuButtonStyle}"
                        Background="#F97316"
                        Click="AbrirEmpresa_Click"/>

                <!-- Botón Ver pesajes con diseño elegante tipo outline -->
                <Button Content="Ver pesajes"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnVerPesajes_Click"/>

            </UniformGrid>
        </ScrollViewer>

        <!-- Pie de página -->
        <Border Grid.Row="2"
                Background="#E5E7EB"
                Padding="12">
            <TextBlock Text="PesajeApp ©"
                       FontSize="12"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>